import type { Channel, ChannelWrapper } from 'amqp-connection-manager';
import { RabbitConfig } from './rabbit-config';

export abstract class RabbitPublisher {
  private readonly channel: ChannelWrapper;
  private readonly route: string;

  constructor(protected readonly config: RabbitConfig, queue: string,
    routingKey: string, channelName: string) {
    this.route = routingKey;
    this.channel = config.createChannel({
      name: channelName,
      confirm: true,
      json: true,
      publishTimeout: config.publishTimeoutMs,
      setup: async (channel: Channel) => {
        await channel.assertExchange(config.exchange, 'topic', { durable: true });
        await channel.assertQueue(queue, { durable: true });
        await channel.bindQueue(queue, config.exchange, routingKey);
      },
    });
  }

  protected publishMessage(message: unknown): Promise<boolean> {
    return this.channel.publish(this.config.exchange, this.route, message,
      { persistent: true, contentType: 'application/json' });
  }

  close(): Promise<void> { return this.channel.close(); }
}
