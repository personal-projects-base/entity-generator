import type { Request, Response } from 'express';
import { <<entityName>>Repository } from '../repositories/<<entityFileName>>.repository';
import { queryString } from '../common/query';

export <<abstract>>class <<entityName>>Controller {
  constructor(protected readonly repository: <<entityName>>Repository) {}

  async save(request: Request, response: Response): Promise<void> {
    const output = await this.repository.save(request.body);
    response.json(output);
  }

  async update(request: Request, response: Response): Promise<void> {
    const output = await this.repository.update(request.params.id, request.body);
    response.json(output);
  }

  async delete(request: Request, response: Response): Promise<void> {
    await this.repository.delete(request.params.id);
    response.status(204).send();
  }

  async get(request: Request, response: Response): Promise<void> {
    const output = await this.repository.get(request.params.id, queryString(request.query.displayFields, 'displayFields'));
    response.json(output);
  }

  async getAll(request: Request, response: Response): Promise<void> {
    const output = await this.repository.getAll(request.query);
    response.json(output);
  }
}
