import type { Channel, ChannelWrapper } from 'amqp-connection-manager';
import type { ConsumeMessage } from 'amqplib';
import { RabbitConfig } from '../rabbit-config';

export abstract class <<className>> {
  private readonly queue = '<<queue>>';
  private readonly channel: ChannelWrapper;
  private startPromise?: Promise<void>;

  constructor(private readonly config: RabbitConfig) {
    this.channel = config.createChannel({
      name: '<<className>>',
      confirm: false,
      setup: async (channel: Channel) => {
        await channel.assertExchange(config.exchange, 'topic', { durable: true });
        await channel.assertQueue(this.queue, { durable: true });<<queueBinding>>
      },
    });
  }

  start(): Promise<void> {
    if (!this.startPromise) {
      this.startPromise = this.channel.consume(this.queue, message => void this.consume(message),
        { noAck: false, prefetch: this.config.prefetch }).then(() => undefined)
        .catch(error => { this.startPromise = undefined; throw error; });
    }
    return this.startPromise;
  }

  async close(): Promise<void> {
    await this.channel.cancelAll();
    await this.channel.close();
    this.startPromise = undefined;
  }

  private async consume(message: ConsumeMessage): Promise<void> {
    try {
      await this.onMessage(message.content.toString());
      this.channel.ack(message);
    } catch (error) {
      try {
        await this.onError(error, message.content.toString());
      } catch (reportingError) {
        console.error('Failure to report RabbitMQ consumer error', reportingError);
      }
      this.channel.nack(message, false, this.config.requeueOnError);
    }
  }

  protected onError(error: unknown, _message: string): Promise<void> | void {
    console.error('Failure to process RabbitMQ message from queue <<queue>>', error);
  }
  protected abstract onMessage(message: string): Promise<void> | void;
}
