import amqp from 'amqplib';
import { RabbitConfig } from '../rabbit-config';

export abstract class <<className>> {
  private readonly queue = '<<queue>>';

  constructor(private readonly config: RabbitConfig) {}

  async start() {
    const connection = await amqp.connect(this.config.url);
    const channel = await connection.createChannel();
    await channel.assertExchange(this.config.exchange, 'topic', { durable: true });
    await channel.assertQueue(this.queue, { durable: true });<<queueBinding>>
    await channel.prefetch(1);

    await channel.consume(this.queue, async (message) => {
      if (!message) {
        return;
      }

      try {
        await this.onMessage(message.content.toString());
        channel.ack(message);
      } catch (error) {
        channel.nack(message, false, true);
      }
    });
  }

  protected abstract onMessage(message: string): Promise<void> | void;
}
