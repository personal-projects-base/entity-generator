using System.Linq.Expressions;

namespace <<projetcName>>.<<nameSpaceName>>;

public class DynamicFilter
{
    public static Expression<Func<T, bool>> CreateFilter<T>(string filterExpression)
    {
        var logicalOperators = new[] { "and", "or" };
        var operators = logicalOperators.FirstOrDefault(op => filterExpression.Contains(op));
        if (operators != null)
        {
            var conditions = filterExpression.Split(new[] { operators }, StringSplitOptions.RemoveEmptyEntries);
            var filter = BuildFilter<T>(conditions, operators, filterExpression);
            return filter;
        }

        return BuildFilter<T>(new[] { filterExpression }, null, "");
    }

    private static Expression<Func<T, bool>> BuildFilter<T>(string[] conditions, string logicalOperator, string filterExpression)
    {
        Expression<Func<T, bool>> filter = null;
        var expressions = new List<Expression>();
        var parameter = Expression.Parameter(typeof(T), "x");
        foreach (var condition in conditions)
        {
            var parts = condition.Split("eq", StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length == 2)
            {
                var propertyPath = parts[0].Trim();
                var value = parts[1].Trim();
                var binaryExpression = BuildPredicateB<T>(propertyPath, value, filterExpression, parameter);
                expressions.Add(binaryExpression);
            }
        }
        Expression combined = null;

        if (!string.IsNullOrEmpty(logicalOperator) && logicalOperator.Equals("and"))
        {
            expressions.ForEach(e =>
                    {
                            combined = combined == null ? e : Expression.AndAlso(combined, e);
            });

        } else if (!string.IsNullOrEmpty(logicalOperator) && logicalOperator.Equals("or"))
        {
            expressions.ForEach(e =>
                    {
                            combined = combined == null ? e : Expression.Or(combined, e);
            });
        }

        if (combined == null)
        {
            combined = Expression.Constant(true);
        }
        return Expression.Lambda<Func<T, bool>>(combined, parameter);
    }

    private static BinaryExpression BuildPredicateB<T>(string propertyPath, string value,string filterExpression, ParameterExpression parameter)
    {

        var property = GetPropertyExpression(parameter, propertyPath);


        // uuid
        if (Guid.TryParse(value, out Guid guidValue))
        {
            var constant = Expression.Constant(guidValue);
            return Expression.Equal(property, constant);

        }// String
        else if (property.Type == typeof(string))
        {
            return Expression.Equal(property, Expression.Constant(value));
        }
        else
        {
            var constant = Expression.Constant(Enum.Parse(property.Type, value));
            return Expression.Equal(property, constant);
        }

    }

    private static Expression GetPropertyExpression(ParameterExpression parameter, string propertyPath)
    {

        if (!propertyPath.Contains("."))
        {
            return Expression.Property(parameter, propertyPath);
        }

        var propertyNames = propertyPath.Split('.');
        Expression property = parameter;

        foreach (var propertyName in propertyNames)
        {
            property = Expression.Property(property, propertyName);
        }

        return property;
    }
}