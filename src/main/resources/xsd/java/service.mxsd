package <<packageName>>;

import <<rootPackage>>.common.*;
import <<rootPackage>>.converters.*;
import <<rootPackage>>.dtos.*;
import <<rootPackage>>.entities.*;
import <<rootPackage>>.repositories.*;
import <<rootPackage>>.authorization.exception.ServiceException;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.data.domain.PageRequest;
import org.springframework.data.domain.Pageable;
import org.springframework.data.domain.Sort;
import org.springframework.http.HttpStatus;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;
import java.util.UUID;

<<serviceAnnotation>>
public <<abstract>>class <<entityName>>Service {

    @Autowired
    protected <<entityName>>Repository repository;

    @Autowired
    protected <<entityName>>DTOConverter dtoConverter;

    @Autowired
    protected SpecificationFilter<<<entityName>>Entity> specificationFilter;

    @Transactional
    public <<entityName>>DTO save(<<entityName>>DTO obj) {
        var entity = dtoConverter.toEntity(obj, null);
        return dtoConverter.toDTO(repository.save(entity), null);
    }

    @Transactional
    public <<entityName>>DTO update(<<entityName>>DTO obj, <<keyType>> id) {
        var entity = dtoConverter.toEntity(obj, null);
        entity.set<<keySetter>>(id);
        return dtoConverter.toDTO(repository.save(entity), null);
    }

    @Transactional
    public void delete(<<keyType>> id) {
        repository.deleteById(id);
    }

    @Transactional(readOnly = true)
    public <<entityName>>DTO get(<<keyType>> id) {
        return dtoConverter.toDTO(repository.getReferenceById(id), null);
    }

    @Transactional(readOnly = true)
    public ResponseData getAll(RequestData input) {
        if (input.offset <= 0) input.offset = 1;
        input.offset--;
        Pageable pageable = PageRequest.of(input.offset, input.size, createSort(input.order));
        var spec = specificationFilter.customFilter(input.filter);
        var result = repository.findAll(spec, pageable);

        var output = new ResponseData();
        output.total = Math.toIntExact(result.getTotalElements());
        output.contents = dtoConverter.toDTO(result.getContent(), input.displayFields);
        output.size = result.getSize();
        output.offset = input.offset;
        return output;
    }

    protected Sort createSort(String order) {
        if (order == null || order.trim().isEmpty()) {
            return Sort.unsorted();
        }

        String[] parts = order.split(",", -1);
        String property = parts[0].trim();
        if (parts.length > 2 || !property.matches("[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)*")) {
            throw new ServiceException(HttpStatus.BAD_REQUEST, "Invalid order: " + order);
        }

        String direction = parts.length == 2 ? parts[1].trim() : "asc";
        if (!"asc".equalsIgnoreCase(direction) && !"desc".equalsIgnoreCase(direction)) {
            throw new ServiceException(HttpStatus.BAD_REQUEST, "Invalid order: " + order);
        }

        return Sort.by(Sort.Direction.fromString(direction), property);
    }
}
