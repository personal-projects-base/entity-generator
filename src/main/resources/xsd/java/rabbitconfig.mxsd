package <<packageName>>.messaging;

import org.springframework.amqp.core.TopicExchange;
import org.springframework.amqp.rabbit.connection.ConnectionFactory;
import org.springframework.amqp.rabbit.core.RabbitAdmin;
import org.springframework.amqp.support.converter.Jackson2JsonMessageConverter;
import org.springframework.amqp.support.converter.MessageConverter;
import org.springframework.context.annotation.Bean;

public abstract class RabbitConfig {

    @Bean
    public TopicExchange appTopicExchange() {
        return new TopicExchange(resolveExchangeName());
    }

    @Bean
    public TopicExchange appExchange() {
        return new TopicExchange(resolveExchangeName());
    }

    @Bean
    public MessageConverter jsonMessageConverter() {
        return new Jackson2JsonMessageConverter();
    }

    @Bean
    public RabbitAdmin rabbitAdmin(ConnectionFactory connectionFactory) {
        return new RabbitAdmin(connectionFactory);
    }

    protected String resolveExchangeName() {
        RabbitExchange annotation = getClass().getAnnotation(RabbitExchange.class);
        if (annotation == null || annotation.value().isBlank()) {
            throw new IllegalStateException("Rabbit exchange must be configured with @RabbitExchange");
        }
        return annotation.value();
    }
}
